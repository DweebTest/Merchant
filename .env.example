# Copy this file to .env and fill it in. Never commit .env.

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Database ---------------------------------------------------------------
# Single machine: leave DB_HOST=localhost (or "db" when using docker compose).
# Separate database server: set DB_HOST to that server's name or IP.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=merchant
DB_USER=merchant
DB_PASSWORD=
# Or give the whole connection string instead of the parts above:
# DATABASE_URL=mysql+pymysql://merchant:password@db-server:3306/merchant?charset=utf8mb4

# Used by docker compose to create the MySQL root account on first start.
MYSQL_ROOT_PASSWORD=

# --- Attachments ------------------------------------------------------------
# Folder where uploaded files are stored. When the app and database are on
# separate servers, share this folder from the database server and mount it
# here on the app server.
UPLOAD_FOLDER=./instance/uploads
MAX_UPLOAD_MB=25

# --- Sign-in ----------------------------------------------------------------
LOCAL_LOGIN_ENABLED=true
# Set to true once the site is served over HTTPS.
SESSION_COOKIE_SECURE=false
MIN_PASSWORD_LENGTH=10
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Microsoft Entra SSO (step 4) will add ENTRA_TENANT_ID, ENTRA_CLIENT_ID and
# ENTRA_CLIENT_SECRET here.
