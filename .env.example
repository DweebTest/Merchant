# Copy this file to .env and fill it in. Never commit .env.

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Database ---------------------------------------------------------------
# Single machine: leave DB_HOST=localhost (or "db" when using docker compose).
# Separate database server: set DB_HOST to that server's name or IP.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=merchant
DB_USER=merchant
DB_PASSWORD=
# Or give the whole connection string instead of the parts above:
# DATABASE_URL=mysql+pymysql://merchant:password@db-server:3306/merchant?charset=utf8mb4

# Used by docker compose to create the MySQL root account on first start.
MYSQL_ROOT_PASSWORD=

# --- Attachments ------------------------------------------------------------
# Folder where uploaded files are stored. When the app and database are on
# separate servers, share this folder from the database server and mount it
# here on the app server.
UPLOAD_FOLDER=./instance/uploads
MAX_UPLOAD_MB=25

# --- Sign-in ----------------------------------------------------------------
# Merchant passwords. Set to false to allow only "Sign in with Microsoft"
# (do that only after you've signed in with Microsoft as an admin yourself).
LOCAL_LOGIN_ENABLED=true
# Set to true once the site is served over HTTPS.
SESSION_COOKIE_SECURE=false
MIN_PASSWORD_LENGTH=10
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Microsoft sign-in (Entra ID) -------------------------------------------
# Leave blank to hide the "Sign in with Microsoft" button. IT gives you these
# three values from the app registration; see docs/entra-sso.md.
# Only people an admin has added in Merchant can sign in this way.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Optional. Defaults to <this site's address>/login/microsoft/callback. Set it
# if Merchant can't work out its public address (for example behind a proxy).
# ENTRA_REDIRECT_URI=https://merchant.yourcollege.edu/login/microsoft/callback

# --- Look ---------------------------------------------------------------------
# "spaceage" (black control-panel look) or "classic". Each person can still
# switch for themselves with the button in the menu.
DEFAULT_THEME=spaceage

# --- Behind a reverse proxy (IIS, nginx, a load balancer) -------------------
# Number of proxies in front of Merchant whose X-Forwarded-* headers to trust.
# 0 when people connect to Merchant directly; usually 1 behind a proxy.
TRUSTED_PROXIES=0
